<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <PackageId>FastNativeOps</PackageId>
    <Version>0.0.1</Version>
    <Authors>vivainio</Authors>
    <Description>Fast cross-platform file system access via direct P/Invoke (opendir/readdir on Linux and macOS, FindFirstFileEx on Windows).</Description>
    <PackageTags>filesystem;pinvoke;native;directory;performance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/vivainio/FastNativeOps</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup><None Include="../README.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
