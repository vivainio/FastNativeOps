<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <PackageId>FastNativeOps</PackageId>
    <Version>0.0.4</Version>
    <Authors>vivainio</Authors>
    <Description>Fast file system access for .NET via direct P/Invoke (getdents64 and statx on Linux, readdir on macOS); plain System.IO on Windows.</Description>
    <PackageTags>filesystem;pinvoke;native;directory;performance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/vivainio/FastNativeOps</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup><None Include="../README.md" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="FastNativeOps.Tests" /></ItemGroup>
</Project>
